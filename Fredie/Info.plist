<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Raycast and Fredie URL Scheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raycast</string>
				<string>fredie</string>
				<string>com.raycast</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>nl.bentjes.fredie.backup</string>
			<key>UTTypeDescription</key>
			<string>Fredie Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fredie</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Fredie uses automation to perform system actions you explicitly run.</string>
	<key>NSCameraUsageDescription</key>
	<string>Fredie shows a camera preview so you can check yourself, and take a photo to the clipboard.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Fredie reads today's and tomorrow's events so you can join a meeting from the palette.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Fredie lets extensions you run read and edit your reminders.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Fredie uses Bluetooth access only when you run the Toggle Bluetooth action.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Fredie</string>
</dict>
</plist>
